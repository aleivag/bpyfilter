#!/bin/bash
# A throwaway Lima VM that builds bpyfilter's wheel the way CI does, and tests it as root.
#   dev/vm create            create it, boot it, bake the build image (takes a while)
#   dev/vm test [ARGS]       build this checkout's wheel, install it, run the tests (ARGS go to pytest)
#   dev/vm shell [CMD ...]   a root shell (or one command) in the VM, in /src/bpyfilter
#   dev/vm reprovision       run the provisioning again, and rebuild the build image
#   dev/vm bpfilter REF      rebuild the build image with bpfilter at a tag, branch or commit
#   dev/vm delete            throw it away
# VM=name to run several; LIMACTL=path if limactl isn't on your PATH.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
LIMACTL="${LIMACTL:-$(command -v limactl || echo "$HOME/.local/lima/bin/limactl")}"
VM="${VM:-bpyfilter-dev}"

lima() { "$LIMACTL" "$@"; }
in_vm() { lima shell --workdir /src/bpyfilter "$VM" sudo "$@"; }

case "${1:-}" in
  create)
    mount=".mounts = [{\"location\": \"$ROOT\", \"mountPoint\": \"/src/bpyfilter\", \"writable\": true}]"
    lima create --name "$VM" --tty=false --set "$mount" "$ROOT/dev/lima.yaml"
    # Baking the build image can outlast limactl's 10-minute wait: if it gives up, the
    # build keeps going in the VM; `dev/vm shell podman images` shows it when done.
    lima start --tty=false "$VM"
    ;;
  test)
    shift
    in_vm bash /src/bpyfilter/dev/test.sh "$@"
    ;;
  shell)
    shift
    if [ $# -eq 0 ]; then
      lima shell --workdir /src/bpyfilter "$VM" sudo bash -l
    else
      in_vm "$@"
    fi
    ;;
  reprovision)
    in_vm env FORCE=1 bash /src/bpyfilter/dev/provision.sh
    ;;
  bpfilter)
    in_vm env FORCE=1 bash /src/bpyfilter/dev/provision.sh "${2:?usage: dev/vm bpfilter REF}"
    ;;
  delete)
    lima delete -f "$VM"
    ;;
  *)
    sed -n '2,9s/^# \{0,1\}//p' "$0"
    exit 1
    ;;
esac
